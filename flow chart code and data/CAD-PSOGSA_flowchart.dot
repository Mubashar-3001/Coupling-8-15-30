// Fig. 1 of the paper (CAD-PSOGSA pipeline) in Graphviz DOT.
// Render online: paste into https://dreampuf.github.io/GraphvizOnline  (engine: dot)
// Render locally: dot -Tpdf CAD-PSOGSA_flowchart.dot -o CAD-PSOGSA_flowchart.pdf
digraph CADPSOGSA {
  graph [rankdir=TB, newrank=true, nodesep=0.30, ranksep=0.42, fontname="Helvetica", bgcolor="white", pad=0.15];
  node  [shape=box, style="rounded,filled", fillcolor="white", color="black", fontname="Helvetica",
         fontsize=10, width=1.95, height=0.78, margin="0.10,0.05"];
  edge  [arrowsize=0.7, penwidth=1.1, fontname="Helvetica", fontsize=9];

  // diagnostic baseline (dashed, grey)
  valid [label=<Diagnostic baseline (Section 4.2): scenario features, 4 conditionings &times; 8 techniques &times; <i>K</i>,<br/>rank-sum of <i>Sil</i>, <i>DB</i>, <i>XB</i>, projection onto relay zones>,
         style="rounded,filled,dashed", fillcolor="#F2F2F2", width=6.2, height=0.55];

  // row 1
  data   [label=<Protection data:<br/>P/B pairs, fault currents,<br/>CT ratios, bounds, CTI>];
  cgraph [label=<Coupling graph<br/><font point-size="3"> </font><br/><i>A</i><sub><i>ij</i></sub> = P/B pairs<br/><font point-size="3"> </font><br/>linking relays <i>i</i>, <i>j</i>>, fillcolor="#FDEEE0", color="#A65300"];
  ncut   [label=<Normalized cut<br/>into <i>K</i> relay zones<br/>(Section 4.3)>, fillcolor="#FDEEE0", color="#A65300"];
  budget [label=<Budget split<br/><font point-size="3"> </font><br/><i>E</i><sub><i>g</i></sub> &prop; <i>d</i><sub><i>g</i></sub>,  <i>E</i><sub>&part;</sub> &prop; |&part;|<br/><font point-size="3"> </font><br/>(Eq. 13)>];

  // row 2 (drawn right to left)
  disc     [label=<Discrete settings<br/>rounded PS, exact grid<br/>TMS, pickup search>, fillcolor="#FDEEE0", color="#A65300"];
  feas     [label=<feasible<br/>TMS?>, shape=diamond, style="filled", width=1.25, height=0.85];
  boundary [label=<Boundary stage<br/>relays on cut pairs,<br/>all pairs enforced>, fillcolor="#FDEEE0", color="#A65300"];
  interior [label=<Interior stage<br/>each zone, PSOGSA with<br/>entropy restarts>, fillcolor="#FDEEE0", color="#A65300"];

  // exact solver used by every fitness evaluation
  exact [label=<Exact TMS solve for every candidate (Section 3): monotone relaxation from TMS<sup>min</sup>,<br/>certified linear solve of the binding constraints; a requirement above TMS<sup>max</sup> proves infeasibility>,
         fillcolor="#EEF3FB", color="#2B4C8C", width=6.2, height=0.6];

  { rank=same; data; cgraph; ncut; budget; }
  { rank=same; disc; feas; boundary; interior; }

  // main flow
  data -> cgraph -> ncut -> budget;
  budget -> interior;
  boundary -> interior [dir=back];
  feas -> boundary [dir=back];
  disc -> feas [dir=back, label=" yes "];
  feas -> interior [label=<<table border="0" cellborder="0" cellpadding="1" bgcolor="white"><tr><td>no: new seed, at most 5 attempts</td></tr></table>>, constraint=false, style=solid];

  // baseline: compared only
  valid -> data [dir=back, style=dashed];
  valid -> budget [style=dashed, label=<<table border="0" cellborder="0" cellpadding="1" bgcolor="white"><tr><td>compared only</td></tr></table>>];

  // exact solve feeds both search stages
  boundary -> exact [dir=back, style=dotted, color="#2B4C8C", penwidth=1.3];
  interior -> exact [dir=back, style=dotted, color="#2B4C8C", penwidth=1.3];

  // column alignment (invisible)
  data -> disc [style=invis]; cgraph -> feas [style=invis]; ncut -> boundary [style=invis];
}
